# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secrets locais — nunca versionar
.env
.env.local
.env.*.local

# Cobertura gerada por vitest --coverage (ci.yml roda --coverage; artefato, não fonte)
coverage/
covout/

# Supabase local link artifacts — regenerados por `supabase link`
supabase/.temp/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Capturas da conferencia de largura de celular (etapa 270) — geradas, nunca commitadas
capturas/

# Grafo de codigo (graphify) — gerado, nunca commitado
graphify-out/

# Contexto para agentes de IA: gerado pelo contexto.yml na branch `contexto` (nunca em main).
# manual/ e texto humano e fica em main.
docs/contexto/*
!docs/contexto/regras/
docs/contexto/regras/*
!docs/contexto/regras/manual/

{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@/*": ["./src/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2020",
    "types": ["vite/client"],
    "useDefineForClassFields": true
  },
  "include": ["src"],
  "exclude": [
    "src/__tests__",
    "src/api",
    "src/database",
    "src/infrastructure",
    "src/middleware",
    "src/workers",
    "src/application",
    "src/domain",
    "src/lib/analytics",
    "src/lib/api",
    "src/lib/cache",
    "src/lib/crud",
    "src/lib/database",
    "src/lib/graphql",
    "src/lib/i18n",
    "src/lib/logging",
    "src/lib/mfa",
    "src/lib/monitoring",
    "src/lib/password",
    "src/lib/performance",
    "src/config/database.config.ts",
    "node_modules"
  ]
}
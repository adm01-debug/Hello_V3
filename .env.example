NODE_ENV=development
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_VERSION=2.0.0

# Supabase Configuration
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_SUPABASE_URL=https://your_project_id.supabase.co

DB_HOST=localhost
DB_PORT=5432
DB_NAME=hello
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/hello

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_QUEUE_DB=1

JWT_SECRET=your_ultra_secure_jwt_secret_min_32_chars
JWT_EXPIRATION=1h
JOB_ENCRYPTION_KEY=your_32_character_encryption_k
ALLOWED_ORIGIN=http://localhost:3000

RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

CALLS_SERVICE_URL=http://localhost:3001
CONTACTS_SERVICE_URL=http://localhost:3002
EMAIL_SERVICE_API_KEY=your_email_service_api_key
EMAIL_FROM=noreply@hello.app
STORAGE_BUCKET=hello-storage
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key

SENTRY_DSN=your_sentry_dsn
SENTRY_ENVIRONMENT=development
DD_API_KEY=your_datadog_api_key
DD_APP_KEY=your_datadog_app_key
LOG_LEVEL=info

TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/hello_test
TEST_REDIS_HOST=localhost
TEST_REDIS_PORT=6380

FEATURE_ANALYTICS=true
FEATURE_NOTIFICATIONS=true
FEATURE_BETA_FEATURES=false
